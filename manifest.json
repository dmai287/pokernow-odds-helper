{
  "manifest_version": 3,
  "name": "PokerNow Odds Helper",
  "version": "0.1.0",
  "description": "Pot odds and Monte Carlo equity helper for PokerNow. A study/review tool for poker math.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.pokernow.club/*",
    "https://pokernow.club/*",
    "https://www.pokernow.com/*",
    "https://pokernow.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "PokerNow Odds Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pokernow.club/games/*",
        "https://pokernow.club/games/*",
        "https://www.pokernow.com/games/*",
        "https://pokernow.com/games/*"
      ],
      "js": [
        "src/poker/cards.js",
        "src/poker/evaluator.js",
        "src/poker/equity.js",
        "src/poker/decision.js",
        "src/poker/draws.js",
        "src/poker/beats.js",
        "src/poker/ranges.js",
        "src/poker/preflop.js",
        "src/poker/leaks.js",
        "src/poker/coach.js",
        "src/content/scraper.js",
        "src/content/overlay.js",
        "src/content/history.js",
        "src/content/content.js"
      ],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
